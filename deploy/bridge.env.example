# /etc/jarvis/bridge.env — read by jarvis-bridge.service. chmod 600, owner root.
# Never commit the real one.

JARVIS_BRIDGE_PORT=8787

# The public origin. The bridge only accepts WebSockets from origins it has been
# told about, and reading-mode pages embed absolute image URLs back to it.
JARVIS_ALLOWED_ORIGINS=https://jarvis.example.com
JARVIS_PUBLIC_URL=https://jarvis.example.com

# The brain, through a gateway instead of a Claude login. AgentRouter shown;
# any Anthropic-compatible gateway works. Tokens are often locked to one IP —
# the server's.
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_AUTH_TOKEN=

# Which brain: claude (Claude Code, through the gateway above) or agy (Google's
# Antigravity CLI). Change this one line to switch; the settings for the other
# brain can stay where they are.
JARVIS_BRAIN=claude
# Used only when JARVIS_BRAIN=agy. Its binary and sign-in belong to the service
# user — see deploy/README.md.
JARVIS_AGY_MODEL=gemini-3.8-flash-high
JARVIS_AGY_BIN=/var/lib/jarvis/.local/bin/agy
JARVIS_AGY_DIR=/var/lib/jarvis/agy-sessions
# Hosts agy may read pages from. * is all of them, this machine included.
JARVIS_AGY_READ_HOSTS=*

# Claude brain only: which model a conversation starts on, and the ones JARVIS
# offers when asked.
# He can be told to switch to any model the gateway serves; this list is only
# what he suggests.
JARVIS_MODEL=claude-opus-5
JARVIS_MODELS=

# Voice. Use a premade voice: the free ElevenLabs tier cannot use library ones.
ELEVENLABS_API_KEY=
JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# The gateway is not Anthropic; don't phone home to it.
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
